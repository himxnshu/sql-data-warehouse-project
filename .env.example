

DB_SERVER=localhost
# For SQL Server Express use: localhost\SQLEXPRESS
DB_NAME=DataWarehouse
# Use "ODBC Driver 17 for SQL Server" if that is the version you have installed
DB_DRIVER=ODBC Driver 18 for SQL Server

# yes  = Windows authentication (no username/password needed)
# no   = SQL login, then fill DB_USER and DB_PASSWORD
DB_TRUSTED=yes
DB_USER=
DB_PASSWORD=

# Used by the Streamlit dashboard
API_URL=http://localhost:8000
